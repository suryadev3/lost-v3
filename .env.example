PORT=3000
JWT_SECRET=change_this_to_a_long_random_string
APP_URL=http://localhost:3000

# ---- Database (REQUIRED) ----
# Supabase: Project Settings → Database → Connection string → URI (use Transaction pooler)
DATABASE_URL=

# ---- Photo storage (REQUIRED for permanent photos on Render) ----
# Free account: https://cloudinary.com → Dashboard → API Keys
# Without these, photos are saved on local disk and DISAPPEAR when Render restarts.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Email (optional) ----
# Without these, OTP codes still work — they are shown on screen + in Render logs.
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Lost & Found Portal <no-reply@lostfound.app>"
